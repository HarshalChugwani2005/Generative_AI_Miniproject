# Streamlit secrets template.
# - Local: copy to .streamlit/secrets.toml (optional; .env also works)
# - Streamlit Community Cloud: paste these lines into
#   App settings -> Secrets
# Never commit the real secrets.toml (it is in .gitignore).

LLM_PROVIDER = "gemini"
GOOGLE_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-3.5-flash"

# Optional: Groq as an alternative provider
GROQ_API_KEY = ""

# Protects the Admin Dashboard page on a public deployment
ADMIN_PASSWORD = "choose-a-strong-password"
