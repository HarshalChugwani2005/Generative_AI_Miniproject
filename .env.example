# ------------------------------------------------------------------
# ShopEasy Support Chatbot - environment settings (local development)
# Copy this file to ".env" and fill in your key(s).
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# For Streamlit Community Cloud use .streamlit/secrets.toml instead
# (see .streamlit/secrets.toml.example and DEPLOYMENT.md).
# ------------------------------------------------------------------

# Default LLM (can also be switched in the sidebar): gemini | groq | ollama
LLM_PROVIDER=gemini

# --- Google Gemini (default) ---
# Free key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# Other options: gemini-3.5-flash-lite, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash

# --- Groq (hosted Llama) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (local, no key) ---
# Install from https://ollama.com, then run: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# --- Admin Dashboard ---
# Leave empty for no password (fine locally). Set one before deploying publicly.
ADMIN_PASSWORD=

# --- Optional tuning ---
# keyword = offline keyword rules, llm = keywords + LLM classification
SENTIMENT_MODE=keyword
# true = the LLM decides when to look up / cancel orders and create tickets (tool calling)
# false = keyword rules decide (can also be toggled in the sidebar)
USE_TOOL_CALLING=true
# auto = reply in the customer's language; or force one: en | hi | mr
REPLY_LANGUAGE=auto
TEMPERATURE=0.2
REQUEST_TIMEOUT=30
MAX_RETRIES=1

# --- Automatic model fallback ---
# If the selected model is busy/fails, try: backup Gemini models -> other
# configured providers (Groq if a key is set) -> local Ollama.
ENABLE_FALLBACK=true
# Comma-separated backup Gemini models, tried in order
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
